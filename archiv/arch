def handleEvents(self):

        scaleVar = 4999
        if self.scale > 1000000:
            scaleVar = 49999
        if self.scale > 10000000:
            scaleVar = 499999

        if self.scale <= 6000:
            scaleVar = 499
        if self.scale <= 600:
            scaleVar = 49

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = 0
                self.exit()
            elif event.type == pygame.KEYDOWN:
                if event.key == pygame.K_ESCAPE:
                    self.running = 0
                    self.exit()
                if event.key == pygame.K_q:
                    self.timeScale *= 10
                if event.key == pygame.K_e:
                    self.timeScale /= 10
            elif event.type == pygame.MOUSEWHEEL:
                self.generateChunks()
                self.draw()
                if event.y > 0:
                    self.scale += scaleVar
                elif event.y < 0:
                    self.scale -= scaleVar
                if self.scale < 1:
                    self.scale = 1